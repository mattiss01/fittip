# Safe, public project coordinates used by the user-scoped Supabase client.
# For local development, copy the URL and modern `sb_publishable_...` key
# reported by `npx supabase status` into an uncommitted `.env.local` file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only hosted staging policy. Leave both unset for local development.
# Founder staging requires the exact mode and the canonical UUIDs of the
# administratively-created Supabase Auth accounts it admits, comma-separated:
# the owner and at most five friends (ADR-043). Do not put either in NEXT_PUBLIC_.
# FITTIP_RUNTIME_MODE=founder-staging
# FITTIP_ALLOWED_USER_IDS=replace-with-owner-user-id,replace-with-friend-user-id
