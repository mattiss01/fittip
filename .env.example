# Safe, public project coordinates used by the user-scoped Supabase client.
# For local development, copy the URL and modern `sb_publishable_...` key
# reported by `npx supabase status` into an uncommitted `.env.local` file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only hosted staging policy. Leave both unset for local development.
# Founder staging requires the exact mode and the administratively-created
# Supabase Auth owner's canonical UUID. Do not put either value in NEXT_PUBLIC_.
# FITTIP_RUNTIME_MODE=founder-staging
# FITTIP_OWNER_USER_ID=replace-with-owner-user-id
