    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jsdom": "27.3.0",
    "prettier": "3.6.2",
    "supabase": "2.109.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
