# Safe, public project coordinates used by the user-scoped Supabase client.
# For local development, copy the URL and publishable key reported by
# `npx supabase status` into an uncommitted `.env.local` file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
